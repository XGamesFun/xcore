{
  "name": "@xgamesfun/xcore",
  "version": "0.11.0",
  "description": "xgames.fun from the command line: bring a web game you already made, check it as xgames.fun hosts it, give it a backend and a Solana economy, and publish it at a link anyone can play.",
  "keywords": [
    "game",
    "browser-game",
    "html5-game",
    "web-game",
    "game-hosting",
    "game-backend",
    "multiplayer",
    "leaderboard",
    "publish",
    "hosting",
    "godot",
    "unity-webgl",
    "vite",
    "web3",
    "solana",
    "solana-game",
    "web3-gaming",
    "game-economy",
    "loot-box",
    "nft",
    "spl-token",
    "wallet-sign-in",
    "cli",
    "claude-code",
    "codex",
    "ai-agent",
    "agent-skill",
    "xgames.fun"
  ],
  "homepage": "https://xgames.fun/xcore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XGamesFun/xcore.git"
  },
  "bugs": {
    "url": "https://github.com/XGamesFun/xcore/issues"
  },
  "author": "xgames.fun",
  "license": "MIT",
  "type": "module",
  "bin": {
    "xcore": "bin/xcore.mjs"
  },
  "exports": {
    "./package.json": "./package.json",
    "./commands/check": "./commands/check.mjs",
    "./commands/publish": "./commands/publish.mjs",
    "./publish": "./lib/publish/index.mjs",
    "./publish/adopt": "./lib/publish/adopt.mjs",
    "./publish/client": "./lib/publish/client.mjs",
    "./publish/gate": "./lib/publish/gate.mjs",
    "./publish/hosting": "./lib/publish/hosting.mjs",
    "./publish/names": "./lib/publish/names.mjs",
    "./publish/oidc": "./lib/publish/oidc.mjs",
    "./publish/page": "./lib/publish/page.mjs",
    "./publish/scan": "./lib/publish/scan.mjs",
    "./publish/tree": "./lib/publish/tree.mjs",
    "./server/bundle": "./lib/server/bundle.mjs",
    "./server/contract": "./lib/server/contract.mjs",
    "./browser": "./lib/browser.mjs",
    "./check": "./lib/check.mjs",
    "./cli": "./lib/cli.mjs",
    "./config-dir": "./lib/config-dir.mjs",
    "./credentials": "./lib/credentials.mjs",
    "./economy": "./lib/economy.mjs",
    "./open": "./lib/open.mjs",
    "./play-policy": "./lib/play-policy.mjs",
    "./secret-patterns": "./lib/secret-patterns.mjs",
    "./secret-store": "./lib/secret-store.mjs",
    "./solana-rpc": "./lib/solana-rpc.mjs"
  },
  "files": [
    "bin/",
    "commands/",
    "docs/",
    "lib/",
    "loot-page/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tests/browser-skips.mjs --test-reporter-destination=stdout \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "@xgamesfun/solana": "0.29.11",
    "esbuild": "0.28.2",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
